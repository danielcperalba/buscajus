# Copie para .env e ajuste. Todas as variáveis são opcionais: os valores abaixo são os padrões.

# Postgres do docker compose
POSTGRES_USER=buscajus
POSTGRES_PASSWORD=buscajus
POSTGRES_DB=buscajus

# Backend (fora do compose; dentro dele, a URL aponta para o serviço "db").
# 127.0.0.1 e não localhost: no Windows, localhost tenta ::1 primeiro e cada conexão perde ~2 s,
# porque o compose só publica a porta em IPv4.
BUSCAJUS_DATABASE_URL=postgresql+psycopg://buscajus:buscajus@127.0.0.1:5432/buscajus
BUSCAJUS_NIVEL_LOG=INFO
BUSCAJUS_DIRETORIO_RAW=data/raw
BUSCAJUS_DIRETORIO_TMP_CADERNOS=data/tmp-cadernos
BUSCAJUS_DIRETORIO_MODELOS=data/modelos

# Requisições às fontes: User-Agent "BuscaJus/<versão> (+<url do projeto>; <contato>)",
# timeouts, novas tentativas (5xx/timeout com backoff; 429 com Retry-After ou 60 s) e
# pausa quando x-ratelimit-remaining chega a zero.
# BUSCAJUS_HTTP__CONTATO=
BUSCAJUS_HTTP__TIMEOUT_SEGUNDOS=30
BUSCAJUS_HTTP__TIMEOUT_DOWNLOAD_SEGUNDOS=300
BUSCAJUS_HTTP__MAX_TENTATIVAS=5
BUSCAJUS_HTTP__BACKOFF_SEGUNDOS=[5, 15, 45]
BUSCAJUS_HTTP__ESPERA_429_SEGUNDOS=60
BUSCAJUS_HTTP__PAUSA_LIMITE_ESGOTADO_SEGUNDOS=60

# DJEN: tribunais coletados pelo caderno diário e o primeiro dia com "Ementa de Acórdão"
# de cada um. O TJDFT não pode entrar aqui enquanto o conector próprio estiver ativo.
BUSCAJUS_DJEN__ATIVO=true
BUSCAJUS_DJEN__TRIBUNAIS=["TJPR"]
BUSCAJUS_DJEN__INICIO_EMENTAS={"TJPR": "2025-07-23"}
BUSCAJUS_DJEN__REQUISICOES_POR_SEGUNDO=1.0
BUSCAJUS_DJEN__URL_API=https://comunicaapi.pje.jus.br
# Tamanho máximo do ZIP (deve caber no tmpfs do worker, 1100 MB), alerta no log e downloads
# com SHA-256 divergente. Maior caderno do TJPR visto no F1-01: 163 MB.
BUSCAJUS_DJEN__LIMITE_BYTES_CADERNO=1073741824
BUSCAJUS_DJEN__ALERTA_BYTES_CADERNO=524288000
BUSCAJUS_DJEN__TENTATIVAS_HASH=3
# Status de comunicação ativa ("P" em 100% no F1-01) e de cancelada (nenhum confirmado).
# Outro status vira anomalia: o acórdão vai para a quarentena, sem ser tratado como cancelado.
BUSCAJUS_DJEN__STATUS_ATIVOS=["P"]
BUSCAJUS_DJEN__STATUS_CANCELAMENTO=[]

# Anonimização: modelo local de NER de pessoas (camada 2), escolhido no F1-36. Vazio: a
# coleta do DJEN falha antes de acessar a fonte (nada real é processado sem a camada 2).
# BUSCAJUS_ANONIMIZACAO__MODELO_NER=

# API: dados sintéticos fixos no formato do contrato (só para desenvolver o frontend).
BUSCAJUS_API__MOCK=false

# Embeddings (Fase 3; modelo ainda não fixado, F3-06). Exigem `uv sync --group embeddings`.
# BUSCAJUS_EMBEDDINGS__MODELO=intfloat/multilingual-e5-base
# BUSCAJUS_EMBEDDINGS__REVISAO=
BUSCAJUS_EMBEDDINGS__DISPOSITIVO=auto
BUSCAJUS_EMBEDDINGS__TAMANHO_LOTE=32
BUSCAJUS_EMBEDDINGS__TOKENS_POR_TRECHO=450
BUSCAJUS_EMBEDDINGS__SOBREPOSICAO_TOKENS=50

# Agendador do worker (DJEN: coleta diária + checagem de versões; TJDFT: coleta diária com
# recoleta). Desligado até decidir onde os dados reais ficam e até o NER ser validado; a coleta
# precisa rodar de uma máquina no Brasil.
BUSCAJUS_AGENDADOR__ATIVO=false
BUSCAJUS_AGENDADOR__HORARIO_DJEN=09:00
BUSCAJUS_AGENDADOR__DIAS_RETROATIVOS=3
BUSCAJUS_AGENDADOR__DIAS_VERIFICACAO_VERSAO=30
# TJDFT: coleta diária (dia mais recente + reconsulta do anterior + recoleta de N dias).
BUSCAJUS_AGENDADOR__HORARIO_TJDFT=08:00
BUSCAJUS_AGENDADOR__DIAS_RECOLETA_TJDFT=30
# Conferência mensal dos dias antigos do TJDFT (F2-14): dia do mês e limite em dias.
BUSCAJUS_AGENDADOR__DIA_CONFERENCIA_TJDFT=1
BUSCAJUS_AGENDADOR__DIAS_CONFERENCIA_TJDFT=90

# TJDFT: API própria de jurisprudência (página máxima: 40)
BUSCAJUS_TJDFT__ATIVO=true
BUSCAJUS_TJDFT__TAMANHO_PAGINA=40
BUSCAJUS_TJDFT__REQUISICOES_POR_SEGUNDO=1.0
# Leituras completas do dia quando os uuids únicos não batem com hits.value (F2-04).
BUSCAJUS_TJDFT__TENTATIVAS_INTEGRIDADE=3

# Testes que exigem Postgres (banco descartável, apagado pelos testes)
# BUSCAJUS_TEST_DATABASE_URL=postgresql+psycopg://buscajus:buscajus@127.0.0.1:5432/buscajus_teste
