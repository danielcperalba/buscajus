# Copie para .env e ajuste. Todas as variáveis são opcionais: os valores abaixo são os padrões.

# Postgres do docker compose
POSTGRES_USER=buscajus
POSTGRES_PASSWORD=buscajus
POSTGRES_DB=buscajus

# Backend (fora do compose; dentro dele, a URL aponta para o serviço "db")
BUSCAJUS_DATABASE_URL=postgresql+psycopg://buscajus:buscajus@localhost:5432/buscajus
BUSCAJUS_NIVEL_LOG=INFO
BUSCAJUS_DIRETORIO_RAW=data/raw
BUSCAJUS_DIRETORIO_TMP_CADERNOS=data/tmp-cadernos
BUSCAJUS_DIRETORIO_MODELOS=data/modelos

# DJEN: tribunais coletados pelo caderno diário e o primeiro dia com "Ementa de Acórdão"
# de cada um. O TJDFT não pode entrar aqui enquanto o conector próprio estiver ativo.
BUSCAJUS_DJEN__ATIVO=true
BUSCAJUS_DJEN__TRIBUNAIS=["TJPR"]
BUSCAJUS_DJEN__INICIO_EMENTAS={"TJPR": "2025-07-23"}
BUSCAJUS_DJEN__REQUISICOES_POR_SEGUNDO=1.0

# TJDFT: API própria de jurisprudência (página máxima: 40)
BUSCAJUS_TJDFT__ATIVO=true
BUSCAJUS_TJDFT__TAMANHO_PAGINA=40
BUSCAJUS_TJDFT__REQUISICOES_POR_SEGUNDO=1.0

# Testes que exigem Postgres (banco descartável, apagado pelos testes)
# BUSCAJUS_TEST_DATABASE_URL=postgresql+psycopg://buscajus:buscajus@localhost:5432/buscajus_teste
