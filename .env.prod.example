# Produção (F8-01). No servidor: cp .env.prod.example .env, ajuste e proteja (chmod 600 .env).
# Guia completo: docs/implantacao.md. Este arquivo é lido pelo docker compose (substituição de
# variáveis) e repassado a api, worker e migracoes (env_file). Nunca versione o .env.

# Faz "docker compose ..." usar o compose de produção sem -f.
COMPOSE_FILE=compose.prod.yaml
# Tag das imagens construídas no servidor (ex.: o commit implantado).
VERSAO=local

# Caddy: domínio público (DNS A/AAAA apontando para o servidor) e e-mail da conta ACME
# (avisos do Let's Encrypt sobre o certificado).
DOMINIO=buscajus.exemplo.com.br
EMAIL_ACME=ops@exemplo.com.br

# Postgres. Senha obrigatória e forte (em produção, a padrão "buscajus" é recusada).
# Gere com: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=buscajus
POSTGRES_PASSWORD=
POSTGRES_DB=buscajus

# Backup diário (serviço "backup"): hora em UTC, retenção em dias e diretório no host.
BACKUP_HORA_UTC=06:30
BACKUP_RETENCAO_DIAS=14
BACKUP_DIR=/srv/backups/buscajus
# Dono dos backups: id -u e id -g do usuário de operação (dono de BACKUP_DIR).
BACKUP_UID=1000
BACKUP_GID=1000

# Frontend: e-mail do projeto na página de remoção (pendente de decisão; docs/lancamento.md).
CONTATO_EMAIL=
# Timeouts das chamadas do Next.js à API (ms): páginas e conferência do detalhe do acórdão.
API_TIMEOUT_MS=8000
API_TIMEOUT_SITUACAO_MS=3000

BUSCAJUS_NIVEL_LOG=INFO
# Identificação nas requisições às fontes: "BuscaJus/<versão> (+<url>; <contato>)".
BUSCAJUS_HTTP__CONTATO=

# Coleta. Só ligue o agendador depois do NER validado (F1-36/F1-37); ver docs/implantacao.md.
BUSCAJUS_AGENDADOR__ATIVO=false
# BUSCAJUS_ANONIMIZACAO__MODELO_NER=

# Os demais parâmetros (limites, busca, agendador, fontes) têm padrões adequados; a lista
# completa, com comentários, está no .env.example.
